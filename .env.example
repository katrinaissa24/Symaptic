# --- Firebase web app config (Firebase console → Project settings → Your apps → Web app) ---
# Leave these empty to run in local demo mode (no accounts, saved in your browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Server-only (set these in Vercel → Project → Settings → Environment Variables) ---
RESEND_API_KEY=
# Must be on a domain you verified in Resend to email anyone other than yourself.
EMAIL_FROM="Symaptic <invites@yourdomain.com>"
FIREBASE_PROJECT_ID=
# Optional: public URL used in invite links (defaults to the request's host)
APP_URL=
